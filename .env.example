# Copy to .env in repository root. Never commit actual credentials.
PORT=4000
LISTEN_HOST=127.0.0.1
MAX_DOCUMENT_MB=10
# Optional absolute private directory; default is repository storage/documents.
# PRIVATE_STORAGE_DIR=
NODE_ENV=development
# Production requires https CLIENT_ORIGIN and a private backend behind the TLS proxy.
# Explicit proxy IPs/CIDRs only. Never set blanket trust=true.
TRUSTED_PROXY_CIDRS=
# Enable only after HTTPS is verified; subdomains/preload are not enabled.
HSTS_MAX_AGE=0
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# CLI bootstrap/demo only; at least 12 characters and at most 72 UTF-8 bytes.
SEED_PASSWORD=
# Optional bootstrap account settings; email is required in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas > Connect > Drivers. URL-encode password characters.
MONGODB_URI=
# Example shape only: mongodb+srv://<user>:<password>@<cluster>/kou_staj
