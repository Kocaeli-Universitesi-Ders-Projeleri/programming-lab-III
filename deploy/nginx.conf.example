# Review DNS, certificate paths, firewall and reverse-proxy topology before use.
# This is an example, not a deployed or verified TLS configuration.
server {
    listen 80;
    server_name staj.example.invalid;
    return 308 https://staj.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name staj.example.invalid;
    ssl_certificate /etc/ssl/kou/fullchain.pem;
    ssl_certificate_key /etc/ssl/kou/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    # Sensitive operations must have time to finish on the single-instance vize setup.
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host staj.example.invalid;
        proxy_set_header X-Forwarded-Host staj.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 600s;
    }
}
